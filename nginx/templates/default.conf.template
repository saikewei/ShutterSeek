# Rendered by entrypoint.sh at container start. Do not edit this generated file
# inside a running container; change the template and rebuild/reload instead.
server {
    listen 8443 ssl default_server;
    http2 on;
    server_name __ACME_DOMAIN__;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # HSTS is intentionally opt-in: other local services may still use plain
    # HTTP on separate hostnames. Enable it once the whole domain is HTTPS-only.
    # add_header Strict-Transport-Security "max-age=31536000" always;

    location = /nginx-health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # Path-based services managed outside the ShutterSeek image.
    # Files must contain one or more `location` blocks.
    include /etc/nginx/extra/locations/*.conf;

    location / {
        # A variable forces Docker DNS resolution per request instead of
        # pinning the first container IP at nginx startup.
        set $shutterseek_upstream http://__APP_UPSTREAM__;
        proxy_pass $shutterseek_upstream;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_connect_timeout 10s;
        # Creation SSE streams and long uploads need a generous read timeout.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_cache off;
        proxy_redirect off;
    }
}
