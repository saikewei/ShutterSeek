# ShutterSeek 开发环境变量 (复制为 .env.local 填入真实值)
# .env.local 在 .gitignore 中，不会提交

SHUTTERSEEK_DB_USER=
SHUTTERSEEK_DB_PASSWORD=
SHUTTERSEEK_DB_NAME=
SHUTTERSEEK_REDIS_HOST=
SHUTTERSEEK_REDIS_PASSWORD=
SHUTTERSEEK_THUMBNAILS_DIR=/workspaces/ShutterSeek/thumbnails/.thumbnails_1080

# 照片上传（客户端推理后上传）
SHUTTERSEEK_UPLOAD_DIR=/photos_uploads
# 客户端推理模型目录（fp16 ONNX）
SHUTTERSEEK_MODELS_DIR=/models_vision

# 鉴权（必须）
SHUTTERSEEK_JWT_SECRET=
SHUTTERSEEK_ADMIN_PASSWORD=

# HTTPS（可选，启用后走 Let's Encrypt DNS-01 挑战，无需 80/443）
SHUTTERSEEK_TLS_ENABLED=false
SHUTTERSEEK_TLS_DOMAIN=
SHUTTERSEEK_TLS_PORT=8443
SHUTTERSEEK_CERT_DIR=
# 阿里云 DNS API 凭证（DNS-01 挑战用，需有 DNS 修改权限）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# 文字检索（embedding sidecar）
SHUTTERSEEK_EMBED_URL=http://127.0.0.1:8000
SHUTTERSEEK_EMBED_TIMEOUT_MS=10000
SHUTTERSEEK_EMBED_MAX_TEXT=200
# 生产 compose 需在 .env 中设置 EMBED_TOKEN（随机长串）
SHUTTERSEEK_EMBED_TOKEN=
