#!/bin/sh
# ShutterSeek branch discipline: main only accepts merges, never direct commits.
# See AGENTS.md §2/§3. Active only inside this repository (core.hooksPath).
#
# Allows: any commit on dev / feature branches; merge commits on main
#         (including --ff-only, which produces no commit at all).
# Blocks: direct git commit / cherry-pick / revert / amend on main.
# Bypass: git commit --no-verify (not recommended; the rule does not allow it).

branch=$(git symbolic-ref --short -q HEAD 2>/dev/null)
case "$branch" in
  main|master) ;;
  *) exit 0 ;;
esac

# git falls back to pre-commit when pre-merge-commit is missing, so merge
# commits must pass through here. Checking MERGE_HEAD is git's own criterion
# for "a merge is in progress" - more reliable than rev-parse --verify.
git_dir=$(git rev-parse --git-dir 2>/dev/null) || exit 0
if [ -f "$git_dir/MERGE_HEAD" ]; then
  exit 0
fi

cat >&2 <<'EOF'
✗ Rejected: main only accepts merges, direct commits are not allowed.

  Do this instead:
    git checkout dev            # every commit lands on dev
    git checkout main
    git merge --ff-only dev     # or: git merge dev (a merge commit is allowed)

  See AGENTS.md §3 "Workflow and commits".
EOF
exit 1
