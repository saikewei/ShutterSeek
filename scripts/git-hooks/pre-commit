#!/bin/sh
# ShutterSeek commit guards. See AGENTS.md §2/§3.
# Active only inside this repository (core.hooksPath).
#
# 1. Comment text must be English: reject newly added *.go *comment* lines that
#    carry non-ASCII bytes. Only comment lines are inspected on purpose -- Go
#    source legitimately contains Chinese user-facing strings (API error
#    messages such as "无权访问" are rendered by the UI). A trailing comment at
#    the end of a code line is not caught; this is a safety net, not a proof.
#    *.vue / *.ts mix comments with Chinese UI copy and *.md is Chinese by
#    design, so neither is checked.
# 2. Branch discipline: main only accepts merges, never direct commits.
#    Allows: any commit on dev / feature branches; merge commits on main
#            (including --ff-only, which produces no commit at all).
#    Blocks: direct git commit / cherry-pick / revert / amend on main.
# Bypass: git commit --no-verify (not recommended; the rules do not allow it).

# ── 1. Comments must be English (staged Go comment lines) ──────────────────
added=$(git diff --cached -U0 -- '*.go' | grep '^+' | grep -v '^+++')
if [ -n "$added" ]; then
  comments=$(printf '%s\n' "$added" | sed -E 's/^\+[[:space:]]*//' | grep -E '^(//|/\*|\*)')
  offenders=$(printf '%s\n' "$comments" | LC_ALL=C grep -n '[^[:print:][:space:]]' | head -5)
  if [ -n "$offenders" ]; then
    cat >&2 <<EOF
✗ Rejected: newly added Go comment lines contain non-ASCII text.

$offenders

  Code comments must be English (AGENTS.md §3). UI copy, docs/ and AGENTS.md
  stay Chinese -- a Chinese string literal in Go is fine, a Chinese comment
  is not.
EOF
    exit 1
  fi
fi

# ── 2. Branch discipline ───────────────────────────────────────────────────
branch=$(git symbolic-ref --short -q HEAD 2>/dev/null)
case "$branch" in
  main|master) ;;
  *) exit 0 ;;
esac

# git falls back to pre-commit when pre-merge-commit is missing, so merge
# commits must pass through here. Checking MERGE_HEAD is git's own criterion
# for "a merge is in progress" - more reliable than rev-parse --verify.
git_dir=$(git rev-parse --git-dir 2>/dev/null) || exit 0
if [ -f "$git_dir/MERGE_HEAD" ]; then
  exit 0
fi

cat >&2 <<'EOF'
✗ Rejected: main only accepts merges, direct commits are not allowed.

  Do this instead:
    git checkout dev            # every commit lands on dev
    git checkout main
    git merge --ff-only dev     # or: git merge dev (a merge commit is allowed)

  See AGENTS.md §3 "Workflow and commits".
EOF
exit 1
